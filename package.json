{
  "name": "salah-pdf",
  "version": "1.0.0",
  "description": "Salah PDF — a professional desktop PDF editor",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "ensure-electron": "node -e \"require('electron')\"",
    "prepare-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run ensure-electron && npm run prepare-assets && electron-vite dev",
    "build": "npm run prepare-assets && electron-vite build",
    "preview": "npm run ensure-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run ensure-electron && node tests/e2e/smoke.cjs && node tests/e2e/annotate.cjs && node tests/e2e/export.cjs && node tests/e2e/stamp-multi.cjs && node tests/e2e/estimate-regress.cjs && node tests/e2e/right-panel.cjs && node tests/e2e/security.cjs && node tests/e2e/batch.cjs",
    "dist": "npm run build && electron-builder",
    "portable": "node scripts/build-portable.mjs",
    "test:portable": "node tests/e2e/packaged.cjs \"dist-portable/stage/Salah PDF 1.0.0/Salah PDF.exe\" && node tests/e2e/portable-data.cjs \"dist-portable/stage/Salah PDF 1.0.0/Salah PDF.exe\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.salahpdf.app",
    "productName": "Salah PDF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!**/*.map",
      "!node_modules/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "Salah-PDF-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Office"
    },
    "artifactName": "Salah-PDF-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 Mohamed Salah Lutfi",
    "asar": true,
    "portable": {
      "artifactName": "Salah-PDF-Portable-${version}.${ext}"
    },
    "forceCodeSigning": false
  },
  "author": {
    "name": "Mohamed Salah Lutfi"
  },
  "license": "MIT"
}
